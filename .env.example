# Copy this file to .env and fill in your values.  .env is ignored by Git, so secrets stay on your machine.
# Every line is optional except LLM_API_KEY. Delete a line to use the default.

# --- The LLM: any service that speaks the OpenAI chat API and can choose tools (Groq, xAI Grok, Gemini, Ollama's /v1).
# Put the key here, never in the code. Free tiers may let the provider use your prompts: invented data only.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
LLM_TIMEOUT_S=12
# For a local Ollama: LLM_BASE_URL=http://127.0.0.1:11434/v1  (any LLM_API_KEY text works)

# --- Login for the web page, dashboard and bookings API. Set a password before the app is reachable by others.
# DASHBOARD_USER=admin
# DASHBOARD_PASSWORD=

# --- Speech models (names on the Hugging Face Hub; they download on first start)
# STT_ENGINE: transformers (default) or faster_whisper (faster on a CPU)
# STT_ENGINE=faster_whisper
# STT_MODEL=distil-small.en
# TTS_MODEL: piper (default; a reply in well under a second, voice files of about 65 MB download on first start)
#            kokoro (the most natural voice, but about as slow as real time on a small CPU)
#            or facebook/mms-tts-eng (one quick pace, cannot say 7, 8 or 9)
TTS_MODEL=piper
# TTS_VOICE=en_GB-jenny_dioco-medium   # piper: any voice from huggingface.co/rhasspy/piper-voices, e.g. en_GB-alba-medium
#                                      # kokoro: bf_emma, bf_isabella (British), af_heart (American)
# TTS_SPEED=1.0                        # below 1 is slower (piper and kokoro)
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Knowledge search (run `python scripts/ingest.py` after editing data/raw or EMBED_MODEL)
# DOCS_DIR=data/raw
# PROCESSED_DIR=data/processed
# USE_PREBUILT_INDEX=true
MATCH_THRESHOLD=0.35
TOP_K=2

# --- Conversation
# AGENT_HISTORY_TURNS=6
# AGENT_MAX_TOOL_ROUNDS=3
MAX_UNCLEAR_TURNS=2

# --- Appointments (opening hours are in services/scheduling.py)
CLINIC_TIMEZONE=Europe/London
SLOT_MINUTES=30
BOOKING_HORIZON_DAYS=28
MIN_NOTICE_MINUTES=60

# --- Database (PostgreSQL by default; SQLite example: sqlite:///data/voice_agent.db)
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/voice_agent

# --- Web server
HOST=127.0.0.1
PORT=7860

# --- Logging
LOG_LEVEL=INFO
LOG_JSON=true
# Keep false unless debugging: caller words are personal data.
LOG_TRANSCRIPTS=false
